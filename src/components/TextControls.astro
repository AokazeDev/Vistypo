---
import { defaultPreviewText } from '@/data/fonts';
import { fontWeights, textTransforms } from '@/data/fonts';
---

<section
	class="mx-auto w-full max-w-7xl rounded-2xl border border-white/15 bg-white/7 p-4 shadow-lg backdrop-blur-xl sm:p-6"
	role="region"
	aria-labelledby="controls-heading"
>
	<div class="mb-4 flex items-center">
		<h2 id="controls-heading" class="text-lg font-semibold tracking-tight text-white">Controles de texto</h2>
	</div>

	{/* Controles básicos */}
	<div class="space-y-4">
		{/* Grid de controles principales */}
		<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
			{/* Texto personalizado */}
			<div class="space-y-2">
				<label for="custom-text-input" class="block text-sm font-medium text-white/80"> Texto personalizado </label>
				<input
					id="custom-text-input"
					name="custom-text"
					class="w-full resize-none rounded-xl border border-white/15 bg-white/6 px-3 py-2 text-sm text-white placeholder-white/40 shadow-inner backdrop-blur-md transition-all duration-300 focus:border-white/35 focus:bg-white/10 focus:shadow-lg focus:ring-2 focus:ring-white/15 focus:outline-none"
					placeholder="Escribe tu texto aquí..."
					value={defaultPreviewText}
					aria-describedby="custom-text-hint"
				/>
			</div>

			{/* Peso de fuente */}
			<div class="space-y-2">
				<label for="font-weight-select" class="block text-sm font-medium text-white/80"> Peso </label>
				<select
					id="font-weight-select"
					name="font-weight"
					class="w-full rounded-xl border border-white/15 bg-white/6 px-3 py-2 text-sm text-white shadow-inner backdrop-blur-md transition-all duration-300 outline-none focus:border-white/35 focus:bg-white/10 focus:ring-2 focus:ring-white/15"
				>
					{
						fontWeights.map((weight) => (
							<option value={weight.value} selected={weight.value === '400'} class="bg-gray-900">
								{weight.label}
							</option>
						))
					}
				</select>
			</div>

			{/* Tamaño de fuente */}
			<div class="space-y-2">
				<div class="flex items-center justify-between">
					<label for="font-size-slider" class="text-sm font-medium text-white/80"> Tamaño </label>
					<output
						for="font-size-slider"
						id="font-size-output"
						class="rounded-full border border-white/20 bg-white/12 px-2.5 py-0.5 text-xs font-semibold text-white tabular-nums shadow-sm backdrop-blur-sm"
						aria-live="polite"
					>
						28px
					</output>
				</div>
				<input
					type="range"
					id="font-size-slider"
					name="font-size"
					min="12"
					max="120"
					value="28"
					step="1"
					class="h-2 w-full cursor-pointer appearance-none rounded-full border border-white/15 bg-white/10 shadow-inner backdrop-blur-sm transition-all duration-200 outline-none hover:bg-white/15 focus:ring-2 focus:ring-white/25 focus:ring-offset-2 focus:ring-offset-transparent [&::-moz-range-thumb]:h-5 [&::-moz-range-thumb]:w-5 [&::-moz-range-thumb]:cursor-pointer [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-2 [&::-moz-range-thumb]:border-white/50 [&::-moz-range-thumb]:bg-linear-to-br [&::-moz-range-thumb]:from-white [&::-moz-range-thumb]:to-gray-300 [&::-moz-range-thumb]:shadow-lg [&::-moz-range-thumb]:transition-all [&::-moz-range-thumb]:duration-200 [&::-moz-range-thumb]:hover:scale-110 [&::-moz-range-thumb]:hover:shadow-xl [&::-moz-range-thumb]:active:scale-105 [&::-moz-range-track]:rounded-full [&::-moz-range-track]:border [&::-moz-range-track]:border-white/15 [&::-moz-range-track]:bg-white/10 [&::-webkit-slider-thumb]:h-5 [&::-webkit-slider-thumb]:w-5 [&::-webkit-slider-thumb]:cursor-pointer [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:border-2 [&::-webkit-slider-thumb]:border-white/50 [&::-webkit-slider-thumb]:bg-linear-to-br [&::-webkit-slider-thumb]:from-white [&::-webkit-slider-thumb]:to-gray-300 [&::-webkit-slider-thumb]:shadow-lg [&::-webkit-slider-thumb]:transition-all [&::-webkit-slider-thumb]:duration-200 [&::-webkit-slider-thumb]:hover:scale-110 [&::-webkit-slider-thumb]:hover:shadow-xl [&::-webkit-slider-thumb]:active:scale-105"
					aria-valuemin="12"
					aria-valuemax="120"
					aria-valuenow="48"
				/>
			</div>

			{/* Transformación del texto */}
			<div class="space-y-2">
				<label for="text-transform-select" class="block text-sm font-medium text-white/80"> Transformación </label>
				<select
					id="text-transform-select"
					name="text-transform"
					class="w-full rounded-xl border border-white/15 bg-white/6 px-3 py-2 text-sm text-white shadow-inner backdrop-blur-md transition-all duration-300 outline-none focus:border-white/35 focus:bg-white/10 focus:ring-2 focus:ring-white/15"
				>
					{
						textTransforms.map((transform) => (
							<option value={transform.value} selected={transform.value === 'none'} class="bg-gray-900">
								{transform.label}
							</option>
						))
					}
				</select>
			</div>

			{/* Estilo de fuente (itálica) */}
			<div class="space-y-2 md:col-span-2">
				<label class="flex cursor-pointer items-center gap-3">
					<input
						type="checkbox"
						id="font-style-checkbox"
						name="font-style"
						class="relative h-5 w-5 cursor-pointer appearance-none rounded border-2 border-white/30 bg-white/10 transition-all duration-200 after:absolute after:top-1/2 after:left-1/2 after:-translate-x-1/2 after:-translate-y-1/2 after:text-xs after:font-bold after:text-black after:opacity-0 after:content-['✓'] checked:border-white checked:bg-white/80 checked:after:opacity-100"
						aria-label="Aplicar estilo itálica"
					/>
					<span class="text-sm font-medium text-white/80">Itálica / Cursiva</span>
				</label>
			</div>
		</div>
	</div>

	{/* Botones de acción */}
	<div class="mt-4 w-full">
		<button
			type="button"
			id="reset-button"
			class="w-full cursor-pointer rounded-xl border border-white/20 bg-white/10 px-4 py-2.5 text-sm font-medium text-white shadow-md backdrop-blur-sm transition-transform active:scale-99"
			aria-label="Restablecer valores"
		>
			Restablecer
		</button>
	</div>
</section>
