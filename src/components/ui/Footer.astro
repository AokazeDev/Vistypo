---
import { EnvelopeIcon } from '@/components/icons';
import { ArrowUpIcon, FoldersIcon, GithubIcon } from '@/components/icons';
import { footer } from '@/data/footer';

const iconComponents = {
	github: GithubIcon,
	folders: FoldersIcon,
	email: EnvelopeIcon,
};
---

<footer
	class="relative overflow-hidden border-t border-white/10 px-4 py-12 sm:px-6 lg:px-8"
	role="contentinfo"
	aria-label="Pie de página del sitio"
>
	{/* Fondos líquidos decorativos */}
	<div class="absolute inset-0 -z-10" aria-hidden="true">
		<div class="absolute top-1/2 left-1/3 size-125 rounded-full bg-purple-500/5 blur-3xl"></div>
		<div class="absolute right-1/4 bottom-0 size-100 rounded-full bg-blue-500/5 blur-3xl"></div>
	</div>

	<div class="mx-auto max-w-7xl">
		{/* Layout horizontal con separación */}
		<div class="grid grid-cols-1 items-center justify-center gap-6 md:grid-cols-3 md:justify-between">
			{/* Lado izquierdo - Copyright */}
			<p class="order-2 text-center text-sm font-light text-white/40 md:order-1 md:text-left">
				Hecho con ❤️ por <a href={footer.brand.url} class="underline transition-colors duration-300 hover:text-white"
					>{footer.brand.alias}</a
				>
			</p>

			{/* Centro - Redes sociales */}
			<nav aria-label="Redes sociales" class="order-1 flex items-center justify-center gap-3 md:order-2">
				{
					footer.social.map((social) => {
						const IconComponent = iconComponents[social.icon as keyof typeof iconComponents];
						return (
							<a
								href={social.href}
								target={social.label === 'Email' ? undefined : '_blank'}
								rel={social.label === 'Email' ? undefined : 'noopener noreferrer'}
								class="group rounded-xl border border-white/10 bg-white/5 p-3 backdrop-blur-xl transition-colors duration-300 hover:border-white/20 hover:bg-white/10 focus:ring-2 focus:ring-white/40 focus:outline-none"
								aria-label={social.label}
							>
								<IconComponent class="h-4 w-4 text-white/60 transition-colors duration-300 group-hover:text-white" />
							</a>
						);
					})
				}
			</nav>

			{/* Lado derecho - Botón scroll */}
			<div class="order-3 place-self-center md:place-self-end">
				<button
					type="button"
					onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
					class="group cursor-pointer rounded-xl border border-white/10 bg-white/5 p-3 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/10 focus:ring-2 focus:ring-white/40 focus:outline-none"
					aria-label="Volver al inicio"
				>
					<ArrowUpIcon class="h-4 w-4 text-white/60 transition-colors duration-300 group-hover:text-white" />
				</button>
			</div>
		</div>
	</div>
</footer>
<style>
	footer {
		background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.3));
	}

	@keyframes float {
		0%,
		100% {
			transform: translateY(0px);
		}
		50% {
			transform: translateY(-10px);
		}
	}
</style>
